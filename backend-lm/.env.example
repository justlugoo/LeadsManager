# Copia este archivo a .env y ajusta los valores para tu entorno local.
# .env no se sube al repositorio (ver .gitignore).

# Clave secreta para firmar los JWT. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Tiempo de vida del token de acceso, en segundos.
ACCESS_TOKEN_EXPIRE_SECONDS=3600

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Cadena de conexión a la base de datos.
DATABASE_URL=sqlite:///./leads_manager.db
